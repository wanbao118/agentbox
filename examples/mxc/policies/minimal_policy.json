{
  "version": "0.8.0-alpha",
  "process": {
    "commandLine": "echo \"hello from MXC minimal policy\"",
    "env": ["EXAMPLE=1"]
  },
  "network": {
    "egress": {
      "default": "deny",
      "allow": [
        {
          "to": [
            { "cidr": "0.0.0.0/0" }
          ],
          "ports": [ { "protocol": "tcp", "port": 443 } ]
        }
      ]
    }
  }
}
